# Copy this file to pluto.env and fill it in. Never commit pluto.env.
# (If pluto.env is missing, Pluto falls back to a file named .env.)

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id from @userinfobot (only this user can use the bot)
ALLOWED_USER_ID=
# AI providers: set at least one. They are tried in this order, so if one is
# rate-limited or down, the next one answers.
# Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Groq (console.groq.com/keys)
GROQ_API_KEY=
# Z AI (z.ai/manage-apikey/apikey-list)
ZAI_API_KEY=
# NVIDIA Nemotron (build.nvidia.com -> Get API Key; starts with nvapi-)
NVIDIA_API_KEY=
# Voice notes are transcribed by Groq Whisper, then Gemini (both use the keys above),
# then Sarvam. Sarvam is optional (dashboard.sarvam.ai).
SARVAM_API_KEY=

# Optional
# PLUTO_TZ=Asia/Kolkata
# PLUTO_DB=pluto.db
# PLUTO_PROVIDERS=gemini,groq,zai,nvidia
# PLUTO_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# ZAI_MODEL=glm-4.6
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_THINKING=0          # 1 = let Nemotron reason first (smarter, much slower)
# STT_PROVIDERS=groq,gemini,sarvam
# GROQ_STT_MODEL=whisper-large-v3
# SARVAM_STT_MODEL=saarika:v2.5
