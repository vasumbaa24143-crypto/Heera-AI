# Copy this file to .env and fill it in. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id from @userinfobot (only this user can use the bot)
ALLOWED_USER_ID=
# Gemini API key (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Sarvam API key for voice notes (dashboard.sarvam.ai). Optional: text works without it.
SARVAM_API_KEY=

# Optional
# PLUTO_TZ=Asia/Kolkata
# PLUTO_DB=pluto.db
# PLUTO_MODEL=gemini-2.5-flash
# SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# SARVAM_STT_MODEL=saaras:v3
